generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  CUSTOMER
  PERFORMER
  ORGANIZER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PRO
  CHOREOGRAPHER
}

enum BookingStatus {
  PENDING
  PAYMENT_VERIFIED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  UPI_QR_DYNAMIC
  UPI_QR_STATIC
  GATEWAY_RAZORPAY
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  // Basic & Auth Details
  name              String
  email             String      @unique
  phone             String      @unique
  passwordHash      String
  avatarUrl         String?
  gender            Gender      @default(OTHER)
  role              Role        @default(CUSTOMER)
  
  // Physical & Personal Details
  height            Decimal?    @db.Decimal(5, 2)
  dateOfBirth       DateTime?   @db.Date
  languages         String[]    @default(["Gujarati", "Hindi"])
  
  // Location Details
  address           String?
  city              String?
  state             String?
  pincode           String?
  latitude          Decimal?    @db.Decimal(10, 7)
  longitude         Decimal?    @db.Decimal(10, 7)
  
  // Dance & Performer Profile
  bio               String?     @db.Text
  skillLevel        SkillLevel  @default(INTERMEDIATE)
  danceStyles       String[]    @default(["Traditional Garba", "Dodhiya", "Dandiya Raas"])
  experienceYears   Int?        @default(0)
  instagramHandle   String?
  
  // Booking & Financial Details
  hourlyRate        Decimal?    @db.Decimal(10, 2)
  upiId             String?
  isAvailable       Boolean     @default(true)
  
  // Ratings & Stats
  rating            Decimal     @default(0.0) @db.Decimal(3, 2)
  reviewCount       Int         @default(0)
  totalBookingsDone Int         @default(0)

  // Account State
  isActive          Boolean     @default(true)
  isVerified        Boolean     @default(false)

  // Relationships
  photos            UserPhoto[]
  bookingsMade      Booking[]   @relation("CustomerBookings")
  bookingsReceived  Booking[]   @relation("PerformerBookings")

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([role, isAvailable, city])
  @@index([skillLevel, city])
  @@map("users")
}

model UserPhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl  String
  publicId  String?
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("user_photos")
}

model Booking {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingCode    String        @unique
  
  // Booker / Client Contact & Personal Details
  name           String
  email          String
  phone          String
  address        String
  gender         Gender        @default(OTHER)

  // The customer who is booking (Foreign Key to User)
  customerId     String        @db.Uuid
  customer       User          @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  
  // The performer/dancer being booked
  performerId    String        @db.Uuid
  performer      User          @relation("PerformerBookings", fields: [performerId], references: [id], onDelete: Restrict)

  // Slot Timings
  bookingDate    DateTime      @db.Date
  startTime      DateTime
  endTime        DateTime
  durationHours  Decimal       @db.Decimal(4, 2)
  
  // Event Location & Notes
  eventAddress   String?
  city           String?
  notes          String?       @db.Text

  // Financials
  hourlyRate     Decimal       @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  advanceAmount  Decimal       @default(0) @db.Decimal(10, 2)

  status         BookingStatus @default(PENDING)
  expiresAt      DateTime?

  payments       Payment[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([performerId, bookingDate, status])
  @@index([customerId, status])
  @@index([phone])
  @@index([email])
  @@map("bookings")
}

model Payment {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId            String        @db.Uuid
  booking              Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("INR")
  paymentMethod        PaymentMethod @default(UPI_QR_DYNAMIC)
  paymentStatus        PaymentStatus @default(PENDING)

  // QR Code & Payment Data
  qrCodeUrl            String?
  upiPayload           String?
  transactionRef       String        @unique
  utrNumber            String?
  paymentScreenshotUrl String?
  
  // Gateway specific
  gatewayOrderId       String?
  gatewayPaymentId     String?
  metadata             Json?

  paidAt               DateTime?
  expiresAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([bookingId])
  @@index([transactionRef])
  @@map("payments")
}
